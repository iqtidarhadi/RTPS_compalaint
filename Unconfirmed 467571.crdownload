--
-- Table structure for table `union_councils`
--

DROP TABLE IF EXISTS `union_councils`;
CREATE TABLE IF NOT EXISTS `union_councils` (
  `id` bigint(20) UNSIGNED NOT NULL AUTO_INCREMENT,
  `title` varchar(125) DEFAULT NULL,
  `ur_title` varchar(125) DEFAULT NULL,
  `district_id` bigint(20) UNSIGNED NOT NULL,
  `tehsil_id` bigint(20) UNSIGNED NOT NULL,
  `status` enum('0','1') NOT NULL DEFAULT '1',
  `active` tinyint(4) DEFAULT '1',
  `created_at` timestamp NULL DEFAULT NULL,
  `updated_at` timestamp NULL DEFAULT NULL,
  `deleted_at` timestamp NULL DEFAULT NULL,
  PRIMARY KEY (`id`) USING BTREE,
  KEY `union_councillors_district_id_foreign` (`district_id`) USING BTREE,
  KEY `union_councillors_tehsil_id_foreign` (`tehsil_id`) USING BTREE
) ENGINE=InnoDB AUTO_INCREMENT=363 DEFAULT CHARSET=utf8mb4 ROW_FORMAT=DYNAMIC;

